NODE_ENV=production
VITE_API_URL=https://api.ecoclean.sl/api
VITE_MAP_TILE_URL=https://tiles.ecoclean.sl/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=ECOCLEAN SL Map Service and OpenStreetMap contributors
VITE_GOOGLE_MAPS_API_KEY=SET_A_DOMAIN_RESTRICTED_GOOGLE_MAPS_BROWSER_KEY
GOOGLE_MAPS_API_KEY=SET_A_SERVER_RESTRICTED_GOOGLE_MAPS_KEY_IF_SERVER_GEOCODING_IS_ENABLED
API_PORT=4000
FRONTEND_URL=https://app.ecoclean.sl
JWT_SECRET=GENERATE_A_UNIQUE_64_CHARACTER_SECRET
JWT_EXPIRES_IN=8h
COOKIE_SECURE=true
DB_HOST=production-database-host
DB_PORT=3306
DB_DATABASE=ecoclean
DB_USERNAME=ecoclean_application
DB_PASSWORD=USE_A_SECRET_MANAGER
DB_DUMP_BINARY=mysqldump
ARCHIVE_BINARY=tar
CLAMDSCAN_BINARY=clamdscan
REQUIRE_CLEAN_UPLOADS=true
WORKERS_ENABLED=true
WORKER_INTERVAL_MS=60000
DB_POOL_SIZE=20
SEED_DEMO_PASSWORD=DO_NOT_SEED_DEMO_ACCOUNTS_IN_PRODUCTION
