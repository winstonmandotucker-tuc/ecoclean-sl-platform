# ECOCLEAN SL Apache 2.4 template. Replace PROJECT_ROOT and API_HOST before enabling.
<VirtualHost *:80>
    ServerName ecoclean.local
    DocumentRoot "PROJECT_ROOT/dist"
    <Directory "PROJECT_ROOT/dist">
        Options -Indexes
        AllowOverride None
        Require all granted
        FallbackResource /index.html
    </Directory>
    ProxyPreserveHost On
    ProxyPass /api http://API_HOST:4000/api
    ProxyPassReverse /api http://API_HOST:4000/api
    <Directory "PROJECT_ROOT/storage">
        Require all denied
    </Directory>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    ErrorLog "logs/ecoclean-error.log"
    CustomLog "logs/ecoclean-access.log" combined
</VirtualHost>
